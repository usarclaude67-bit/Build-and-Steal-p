local function renderAI(rec, animate)
	local _, bubble = newRow("ai")
	local order = 0
	local function nextOrder() order = order + 1 return order end
	local segs = parseSegments(rec.text)
	if #segs == 0 then segs = { { type = "text", content = rec.text } } end
	for _, seg in ipairs(segs) do
		if seg.type == "text" then
			for _, part in ipairs(splitLong(seg.content, 8000)) do
				createText(bubble, toRich(part), nextOrder(), { rich = true })
			end
		else
			createCodeBlock(bubble, seg.lang, seg.content, nextOrder())
		end
	end
	local footer = new("Frame", { Name = "Footer", LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1 }, bubble)
	new("TextLabel", {
		Text = os.date("%H:%M", rec.t or os.time()), Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = THEME.subtext,
		TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, Size = UDim2.new(0.5, 0, 1, 0),
	}, footer)
	local cp = iconButton(footer, "📋", 20, 10, 0)
	cp.AnchorPoint, cp.Position = Vector2.new(1, 0.5), UDim2.new(1, 0, 0.5, 0)
	cp.Activated:Connect(function() flash(cp, copyToClipboard(rec.text)) end)
	if animate then popIn(bubble) end
end

local function renderRecord(rec, animate)
	if rec.k == "user" then
		local _, bubble = newRow("user")
		createText(bubble, rec.text, 1, { color = Color3.new(1, 1, 1) })
		if rec.vision then
			createText(bubble, "👁 " .. rec.vision, 2, { color = Color3.fromRGB(215, 225, 255), size = 10 })
		end
		if animate then popIn(bubble) end
	elseif rec.k == "ai" then
		renderAI(rec, animate)
	elseif rec.k == "tool" then
		local _, bubble = newRow("ai")
		local color = rec.ok and THEME.ok or THEME.danger
		createText(bubble, ("🛠 <b>%s</b>  %s\n<font color=\"#9696A6\">%s</font>"):format(
			escapeRich(rec.name or "?"), rec.ok and "✓" or "✗", escapeRich(shorten(rec.text or "", 400))),
