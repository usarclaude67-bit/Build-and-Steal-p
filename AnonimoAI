	local start = math.max(1, #c.log - CONFIG.RENDER_LIMIT + 1)
	if start > 1 then notice(("… %d mensagens anteriores estão salvas (exibindo as mais recentes)"):format(start - 1)) end
	for i = start, #c.log do
		renderRecord(c.log[i], false)
		if i % 6 == 0 then
			task.wait()
			if token ~= renderToken then return end
		end
	end
	requestScroll()
	refreshUsageUI()
end

local function addRecord(c, rec)
	rec.t = rec.t or os.time()
	c.log[#c.log + 1] = rec
	c.updated = os.time()
	if rec.k == "user" and (c.title == "Novo chat" or c.title == "") then
		c.title = shorten(rec.text, 32)
	end
	Chats[c.id] = c
	touchIndex(c)
	markDirty("chat:" .. c.id)
	if c == Current then
		hideEmptyState()
		renderRecord(rec, true)
		requestScroll()
	end
end

local function loadChat(id)
	if Chats[id] then return Chats[id] end
	local c = jsonRead(PATH.chats .. "/" .. id .. ".json")
	if type(c) ~= "table" or type(c.log) ~= "table" then return nil end
	c.contents = type(c.contents) == "table" and c.contents or {}
	c.ctxTokens = tonumber(c.ctxTokens) or 0
	Chats[id] = c
	return c
end

local function openChat(c)
	Current = c
	Settings.current = c.id
	markDirty("settings")
	task.spawn(renderChat, c)
end

local function newChat()
	if Current and #Current.log == 0 then
		notice("Você já está em um chat vazio.")
		return
	end
	openChat(newChatObject())
end

local function deleteChat(id)
	for i, m in ipairs(Index) do
		if m.id == id then table.remove(Index, i) break end
	end
	Chats[id] = nil
	dirty["chat:" .. id] = nil
	markDirty("index")
	if FS_OK and delfile then pcall(delfile, PATH.chats .. "/" .. id .. ".json") end
	if Current and Current.id == id then
		local nextMeta = Index[1]
		local nextChat = nextMeta and loadChat(nextMeta.id) or nil
		openChat(nextChat or newChatObject())
	end
end

local function exportText(c)
	local parts = { CONFIG.APP_NAME .. " — " .. c.title }
	for _, r in ipairs(c.log) do
		if r.k == "user" then
			parts[#parts + 1] = "Você:\n" .. r.text
		elseif r.k == "ai" then
			parts[#parts + 1] = CONFIG.APP_NAME .. ":\n" .. r.text
		elseif r.k == "tool" then
			parts[#parts + 1] = ("[ferramenta %s] %s"):format(r.name or "?", r.text or "")
		end
	end
	return table.concat(parts, "\n\n")
end

