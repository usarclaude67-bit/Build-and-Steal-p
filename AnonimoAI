local function doSubmit(text, opts)
	opts = opts or {}
	if State.busy then
		notice("⚠ Aguarde a resposta atual terminar.")
		return
	end
	if Settings.apiKey == "" then
		notice("⚠ Falta a API Key. Digite: /key SUA_CHAVE (grátis em aistudio.google.com/apikey)")
		return
	end
	local chatObj = Current
	setBusy(true)
	inputBox.Text = ""
	local visionOn = Settings.vision or opts.forceVision
	addRecord(chatObj, { k = "user", text = text, vision = visionOn and "tela anexada" or nil })
	local stop = showTyping()

	task.spawn(function()
		local okRun, ok, err = pcall(function()
			local extras
			if visionOn then
				setStatus("Capturando a tela")
				local snap = visionSnapshot(opts.forceVision)
				extras = {}
				if snap.image then extras[#extras + 1] = { inlineData = { mimeType = "image/png", data = snap.image } } end
				extras[#extras + 1] = { text = "[Contexto visual automático da tela do usuário — método: " .. snap.method .. "]\n" .. snap.scan }
				if snap.shotError and Vision.shotFails == 2 then
					notice("ℹ Print indisponível (" .. shorten(tostring(snap.shotError), 90) .. "). Usando varredura de cena.")
				end
			end
			return runAgentTurn(chatObj, text, extras)
		end)
		stop()
		if not okRun then
			addRecord(chatObj, { k = "sys", text = "⚠ Erro interno: " .. tostring(ok) })
		elseif not ok then
			addRecord(chatObj, { k = "sys", text = "⚠ " .. tostring(err) })
		end
		setBusy(false)
		refreshUsageUI()
	end)
end
submit = function(text) doSubmit(text) end

