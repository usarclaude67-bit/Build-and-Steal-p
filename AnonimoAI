local function friendlyError(status, msg)
	local m = tostring(msg or "")
	local low = m:lower()
	if status == 400 and (low:find("api key") or low:find("api_key")) then return "API Key invalida. Use /key SUA_CHAVE." end
	if status == 403 then return "Acesso negado (403): " .. m end
	if status == 429 then return "Cota/limite de requisicoes atingido (429). Aguarde um pouco ou ajuste /limite. " .. shorten(m, 120) end
	return ("Erro da API (%s): %s"):format(tostring(status), shorten(m, 240))
end

-- retorna (true, {content, text, calls, usage, finish}) ou (false, erro)
local function apiGenerate(contents, systemText, withTools, onStatus)
	local body = {
		systemInstruction = { parts = { { text = systemText } } },
		contents = contents,
		generationConfig = { maxOutputTokens = CONFIG.MAX_OUTPUT_TOKENS },
	}
	if Settings.thinking ~= "" and not State.noThinking then
		body.generationConfig.thinkingConfig = { thinkingLevel = Settings.thinking }
	end
	if withTools then body.tools = buildToolsDecl() end

	local fallbackIdx = 0
	local model = State.activeModel or Settings.model
	local attempts, lastErr = 0, "erro desconhecido"

	while attempts < CONFIG.MAX_RETRIES + 3 do
		attempts = attempts + 1
		waitForSlot(onStatus)
		local url = ("https://generativelanguage.googleapis.com/v1beta/models/%s:generateContent"):format(model)
		local okEnc, payload = pcall(HttpService.JSONEncode, HttpService, body)
		if not okEnc then return false, "falha ao montar requisicao: " .. tostring(payload) end
		local headers = { ["Content-Type"] = "application/json", ["x-goog-api-key"] = Settings.apiKey }

		if onStatus then onStatus("Pensando") end
		local ok, status, raw = httpPost(url, headers, payload)
		if not ok then
			local hint = httpRequest and "" or "\n(seu executor nao expoe request/http_request)"
			return false, "falha de rede: " .. tostring(raw) .. hint
		end
		noteRequest()

		local decoded, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if not decoded then data = nil end

		if status >= 200 and status < 300 and type(data) == "table" then
			local cand = data.candidates and data.candidates[1]
			local content = cand and cand.content
			if content and type(content.parts) == "table" then
				local texts, calls = {}, {}
				for _, p in ipairs(content.parts) do
					if p.text and not p.thought then texts[#texts + 1] = p.text end
					if p.functionCall then
						local fc = p.functionCall
						if type(fc.args) == "table" and next(fc.args) == nil then fc.args = nil end
						calls[#calls + 1] = fc
					end
				end
				content.role = "model"
				local p = noteTokens(data.usageMetadata)
				State.activeModel = (model ~= Settings.model) and model or nil
				return true, {
					content = content, text = table.concat(texts), calls = calls,
					promptTokens = p, finish = cand.finishReason,
				}
			end
			noteTokens(data.usageMetadata)
			local block = data.promptFeedback and data.promptFeedback.blockReason
			return false, block and ("Prompt bloqueado: " .. tostring(block))
				or ("Resposta vazia (finishReason: " .. tostring(cand and cand.finishReason) .. ")")
		end

		local msg = type(data) == "table" and data.error and data.error.message or ("HTTP " .. tostring(status))
		lastErr = friendlyError(status, msg)

		if status == 404 and CONFIG.MODEL_FALLBACKS[fallbackIdx + 1] then
			fallbackIdx = fallbackIdx + 1
			model = CONFIG.MODEL_FALLBACKS[fallbackIdx]
			if onStatus then onStatus("Modelo indisponivel, tentando " .. model) end
		elseif status == 400 and body.generationConfig.thinkingConfig and tostring(msg):lower():find("thinking") then
			body.generationConfig.thinkingConfig = nil
			State.noThinking = true
		elseif status == 429 or status >= 500 or status == 0 then
			local wait = tonumber(tostring(msg):match("retry in ([%d%.]+)s")) or (1.5 * attempts)
			if attempts >= CONFIG.MAX_RETRIES + 2 then break end
			if onStatus then onStatus(("Servidor ocupado, tentando de novo (%ds)"):format(math.ceil(wait))) end
			task.wait(math.min(wait, 30))
		else
			return false, lastErr
		end
	end
	return false, lastErr
end

