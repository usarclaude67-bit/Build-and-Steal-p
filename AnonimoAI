local LUA_KEYWORDS, BUILTINS = {}, {}
for _, k in ipairs({ "and", "break", "do", "else", "elseif", "end", "false", "for", "function", "if", "in",
	"local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while", "continue" }) do
	LUA_KEYWORDS[k] = true
end
for _, k in ipairs({ "game", "workspace", "script", "self", "print", "warn", "error", "pairs", "ipairs", "next",
	"tostring", "tonumber", "type", "typeof", "pcall", "xpcall", "require", "task", "math", "string", "table",
	"os", "Instance", "Vector3", "Vector2", "CFrame", "Color3", "UDim2", "UDim", "Enum", "TweenInfo", "Random",
	"Ray", "Rect", "NumberRange", "NumberSequence", "ColorSequence", "setmetatable", "getmetatable", "select",
	"unpack", "assert", "tick", "time", "wait", "spawn", "delay", "coroutine", "utf8", "bit32", "shared", "_G" }) do
	BUILTINS[k] = true
end

local function highlightLua(code)
	local out, n, i = {}, #code, 1
	local function emit(color, s)
		s = escapeRich(s)
		out[#out + 1] = color and ('<font color="' .. color .. '">' .. s .. '</font>') or s
	end
	while i <= n do
		local c = code:sub(i, i)
		if code:sub(i, i + 1) == "--" then
			local eq = code:match("^%-%-%[(=*)%[", i)
			local e
			if eq then
				local _, ce = code:find("]" .. eq .. "]", i + 2, true)
				e = ce or n
			else
				local nl = code:find("\n", i, true)
				e = nl and (nl - 1) or n
			end
			emit(SYN.comment, code:sub(i, e))
			i = e + 1
		elseif c == '"' or c == "'" then
			local j = i + 1
			while j <= n do
				local d = code:sub(j, j)
				if d == "\\" then
					j = j + 2
				elseif d == c or d == "\n" then
					break
				else
					j = j + 1
				end
			end
			local e = (j <= n and code:sub(j, j) == c) and j or math.min(j - 1, n)
			emit(SYN.string, code:sub(i, e))
			i = e + 1
		elseif c == "[" and code:match("^%[=*%[", i) then
			local eq = code:match("^%[(=*)%[", i)
			local _, ce = code:find("]" .. eq .. "]", i + 1, true)
			local e = ce or n
			emit(SYN.string, code:sub(i, e))
			i = e + 1
		elseif c:match("%d") then
			local num = code:match("^0[xX][%x_]+", i) or code:match("^%d[%d_]*%.?%d*", i) or c
			emit(SYN.number, num)
			i = i + #num
		elseif c:match("[%a_]") then
			local id = code:match("^[%w_]+", i)
			local nextCh = code:sub(i + #id, i + #id)
			local color
			if LUA_KEYWORDS[id] then
				color = SYN.keyword
			elseif BUILTINS[id] then
				color = SYN.builtin
			elseif nextCh == "(" then
				color = SYN.func
			end
			emit(color, id)
			i = i + #id
		else
			local j = i + 1
			while j <= n and not code:sub(j, j):match("[%w_\"'%-%[]") do j = j + 1 end
			emit(nil, code:sub(i, j - 1))
			i = j
		end
	end
	return table.concat(out)
end

local function chunkCode(code, maxLen)
	local chunks, cur, curLen = {}, {}, 0
	for line in (code .. "\n"):gmatch("(.-)\n") do
		if curLen + #line + 1 > maxLen and #cur > 0 then
			chunks[#chunks + 1] = table.concat(cur, "\n")
			cur, curLen = {}, 0
		end
		cur[#cur + 1] = line
		curLen = curLen + #line + 1
	end
	if #cur > 0 then chunks[#chunks + 1] = table.concat(cur, "\n") end
	return chunks
end

local function toRich(text)
	local lines = {}
	for line in (text .. "\n"):gmatch("(.-)\n") do
		local heading = line:match("^%s*#+%s+(.+)$")
		local bullet = (not heading) and line:match("^%s*[%*%-%+]%s+(.+)$")
		local t = escapeRich(heading or bullet or line)
		t = t:gsub("`([^`]+)`", '<font face="Code" color="' .. SYN.inline .. '">%1</font>')
		t = t:gsub("%*%*(.-)%*%*", "<b>%1</b>")
		if heading then
			t = "<b>" .. t .. "</b>"
		elseif bullet then
			t = "  •  " .. t
		end
		lines[#lines + 1] = t
	end
	return table.concat(lines, "\n")
end

local function parseSegments(text)
	local segs, pos, len = {}, 1, #text
	while pos <= len do
		local s, e = text:find("```", pos, true)
		if not s then
			local rest = text:sub(pos)
			if rest:match("%S") then segs[#segs + 1] = { type = "text", content = trim(rest) } end
			break
		end
		local before = text:sub(pos, s - 1)
		if before:match("%S") then segs[#segs + 1] = { type = "text", content = trim(before) } end
		local cs, ce = text:find("```", e + 1, true)
		local block
		if cs then
			block = text:sub(e + 1, cs - 1)
			pos = ce + 1
		else
			block = text:sub(e + 1)
			pos = len + 1
		end
		local lang, remainder = block:match("^([%w_%+%-#%.]*)[ \t]*\r?\n(.*)$")
		if lang then block = remainder else lang = "" end
		block = block:gsub("^%s*\n", ""):gsub("%s+$", "")
		if block ~= "" then segs[#segs + 1] = { type = "code", lang = lang:lower(), content = block } end
	end
	return segs
end

