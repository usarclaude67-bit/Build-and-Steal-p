defTool("get_nearby",
	"Lista objetos e jogadores proximos do personagem.",
	{ radius = { type = "NUMBER", description = "Raio em studs (padrao 40, max 300)" } },
	function(a)
		local ch, root = myRig()
		if not root then return false, "personagem nao encontrado" end
		local radius = math.clamp(tonumber(a.radius) or 40, 5, 300)
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { ch }
		local parts = workspace:GetPartBoundsInRadius(root.Position, radius, params)
		local groups, order = {}, {}
		for _, p in ipairs(parts) do
			local model = p:FindFirstAncestorOfClass("Model")
			local label = (model and model ~= workspace) and model.Name or p.Name
			local g = groups[label]
			local d = (p.Position - root.Position).Magnitude
			if not g then
				g = { n = 0, min = d }
				groups[label] = g
				order[#order + 1] = label
			end
			g.n = g.n + 1
			if d < g.min then g.min = d end
		end
		table.sort(order, function(x, y) return groups[x].min < groups[y].min end)
		local out = { ("Objetos em %d studs (%d pecas):"):format(math.floor(radius), #parts) }
		for i = 1, math.min(20, #order) do
			out[#out + 1] = ("  - %s (%d pecas, mais proximo a %.0f studs)"):format(order[i], groups[order[i]].n, groups[order[i]].min)
		end
		for _, p in ipairs(Players:GetPlayers()) do
			local hrp = p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if hrp and (hrp.Position - root.Position).Magnitude <= radius then
				out[#out + 1] = ("  * jogador %s a %.0f studs"):format(p.DisplayName, (hrp.Position - root.Position).Magnitude)
			end
		end
		return true, table.concat(out, "\n")
	end)

