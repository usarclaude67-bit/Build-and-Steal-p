toolCtx.confirmCode = function(code, purpose)
	local decision
	local row, bubble = newRow("ai")
	local msg = "⚠ A IA quer executar código no seu jogo"
	if purpose and tostring(purpose) ~= "" then msg = msg .. ":\n" .. tostring(purpose) end
	createText(bubble, msg, 1, { color = THEME.warn, size = 12 })
	createCodeBlock(bubble, "lua", code, 2)
	local btnRow = new("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 }, bubble)
	local run = actionButton(btnRow, "▶ Executar", THEME.ok, UDim2.new(0.5, -4, 1, 0), UDim2.new(0, 0, 0, 0))
	local cancel = actionButton(btnRow, "✕ Cancelar", THEME.danger, UDim2.new(0.5, -4, 1, 0), UDim2.new(0.5, 4, 0, 0))
	run.Activated:Connect(function() decision = true end)
	cancel.Activated:Connect(function() decision = false end)
	requestScroll()
	local t0 = os.clock()
	while decision == nil and os.clock() - t0 < 180 and row.Parent do task.wait(0.1) end
	if row.Parent then btnRow:Destroy() end
	if row.Parent then
		createText(bubble, decision and "✓ Aprovado pelo usuário" or "✕ Cancelado", 3,
			{ color = decision and THEME.ok or THEME.danger, size = 11 })
	end
	return decision == true
end

-- ═══════════════════════ AGENTE (loop de ferramentas) ═══════════════════════
local function execTool(c, name, args)
	local tool = Tools[name]
	if not tool then
		addRecord(c, { k = "tool", name = name, ok = false, text = "ferramenta desconhecida" })
		return false, "ferramenta desconhecida: " .. tostring(name)
	end
	setStatus("Executando " .. name)
	local okCall, ok, msg = pcall(tool.fn, type(args) == "table" and args or {})
	if not okCall then
		ok, msg = false, "erro interno: " .. tostring(ok)
	end
	msg = tostring(msg or "")
	local rec = { k = "tool", name = name, ok = ok and true or false, text = msg }
	if name == "run_luau" and type(args) == "table" then rec.code = tostring(args.code or "") end
	addRecord(c, rec)
	return ok and true or false, msg
end

local function trimContents(c)
	local contents = c.contents
	while #contents > CONFIG.MAX_CONTEXT_ITEMS do table.remove(contents, 1) end
	while contents[1] do
		local first = contents[1]
		local isUserText = first.role == "user" and first.parts and first.parts[1] and first.parts[1].text ~= nil
		if isUserText then break end
		table.remove(contents, 1)
	end
end

local function buildRequestContents(c, turnStart, extras)
	local out = {}
	for i, item in ipairs(c.contents) do
		if i == turnStart and extras and #extras > 0 then
			local parts = {}
			for _, e in ipairs(extras) do parts[#parts + 1] = e end
			for _, p in ipairs(item.parts) do parts[#parts + 1] = p end
			out[#out + 1] = { role = "user", parts = parts }
		else
			out[#out + 1] = item
		end
	end
	return out
end

local function runAgentTurn(c, userText, extras)
	trimContents(c)
	local turnStart = #c.contents + 1
	c.contents[turnStart] = { role = "user", parts = { { text = userText } } }
	local onStatus = function(t) setStatus(t) end
	local lastPrompt = 0

	for round = 1, CONFIG.MAX_TOOL_ROUNDS + 1 do
		local useTools = Settings.roblox and round <= CONFIG.MAX_TOOL_ROUNDS
		local ctxText = buildServerContext(false)
		local ok, res = apiGenerate(buildRequestContents(c, turnStart, extras), buildSystemPrompt(ctxText), useTools, onStatus)
		if not ok then
			while #c.contents >= turnStart do table.remove(c.contents) end -- descarta o turno incompleto
			return false, res
		end
		lastPrompt = res.promptTokens or lastPrompt
		c.contents[#c.contents + 1] = res.content

		if res.text ~= "" then addRecord(c, { k = "ai", text = res.text }) end
		if #res.calls == 0 then
			if res.text == "" then addRecord(c, { k = "sys", text = "(a IA não retornou texto)" }) end
			break
		end

		local responses = {}
		for _, call in ipairs(res.calls) do
			local okT, msg = execTool(c, call.name, call.args)
			responses[#responses + 1] = {
				functionResponse = {
					id = call.id, name = call.name,
					response = { success = okT, result = msg },
				},
			}
		end
		c.contents[#c.contents + 1] = { role = "user", parts = responses }
	end

	c.ctxTokens = lastPrompt
	c.updated = os.time()
	Chats[c.id] = c
	markDirty("chat:" .. c.id)
	return true
end

local function setBusy(b)
	State.busy = b
	sendBtn.BackgroundTransparency = b and 0.6 or 0
	sendBtn.Text = b and "…" or "↑"
