local ROOT = CONFIG.DATA_FOLDER
local PATH = {
	settings = ROOT .. "/settings.json",
	usage    = ROOT .. "/usage.json",
	index    = ROOT .. "/index.json",
	chats    = ROOT .. "/chats",
}

local function ensureFolders()
	if not FS_OK then return end
	pcall(function()
		if not isfolder(ROOT) then makefolder(ROOT) end
		if not isfolder(PATH.chats) then makefolder(PATH.chats) end
	end)
end

local function jsonWrite(path, tbl)
	if not FS_OK then return false end
	local ok, s = pcall(HttpService.JSONEncode, HttpService, tbl)
	if not ok then return false end
	return (pcall(writefile, path, s))
end

local function jsonRead(path)
	if not FS_OK then return nil end
	local okE, exists = pcall(isfile, path)
	if not (okE and exists) then return nil end
	local okR, s = pcall(readfile, path)
	if not okR or type(s) ~= "string" then return nil end
	local okD, t = pcall(HttpService.JSONDecode, HttpService, s)
	if okD then return t end
	return nil
end

