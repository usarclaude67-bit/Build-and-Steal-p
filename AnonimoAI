local dirty, saveScheduled = {}, false
local flushSaves

local function markDirty(key)
	dirty[key] = true
	if not saveScheduled then
		saveScheduled = true
		task.delay(CONFIG.SAVE_DEBOUNCE, function() flushSaves() end)
	end
end

flushSaves = function()
	saveScheduled = false
	local keys = {}
	for k in pairs(dirty) do keys[#keys + 1] = k end
	table.clear(dirty)
	for _, k in ipairs(keys) do
		if k == "settings" then
			jsonWrite(PATH.settings, Settings)
		elseif k == "usage" then
			jsonWrite(PATH.usage, Usage)
		elseif k == "index" then
			jsonWrite(PATH.index, Index)
		elseif k:sub(1, 5) == "chat:" then
			local id = k:sub(6)
			if Chats[id] then jsonWrite(PATH.chats .. "/" .. id .. ".json", Chats[id]) end
		end
	end
end

local function loadPersisted()
	ensureFolders()
	local s = jsonRead(PATH.settings)
	if type(s) == "table" then
		for k, v in pairs(s) do
			if Settings[k] ~= nil and type(v) == type(Settings[k]) then Settings[k] = v end
		end
	end
	if CONFIG.API_KEY ~= "" then Settings.apiKey = CONFIG.API_KEY end
	local u = jsonRead(PATH.usage)
	if type(u) == "table" then
		for k in pairs(Usage) do
			if u[k] ~= nil and type(u[k]) == type(Usage[k]) then Usage[k] = u[k] end
		end
	end
	local idx = jsonRead(PATH.index)
	if type(idx) == "table" then Index = idx end
end

-- ═══════════════════════ USO / LIMITES ═══════════════════════
local function today() return os.date("%Y-%m-%d") end

local function rollDay()
	if Usage.day ~= today() then
		Usage.day = today()
		Usage.reqs, Usage.tokens, Usage.promptTokens, Usage.outTokens = 0, 0, 0, 0
	end
end

local function rpmNow()
	local now, i = os.clock(), 1
	while i <= #stamps do
		if now - stamps[i] >= 60 then table.remove(stamps, i) else i = i + 1 end
	end
	return #stamps
end

local function waitForSlot(onStatus)
	local waited = 0
	while rpmNow() >= Settings.rpm and waited < 65 do
		local remain = math.max(1, math.ceil(60 - (os.clock() - stamps[1])))
		if onStatus then onStatus(("Aguardando limite por minuto (%ds)"):format(remain)) end
		task.wait(1)
		waited = waited + 1
	end
end

local function noteRequest()
	rollDay()
	stamps[#stamps + 1] = os.clock()
	Usage.reqs = Usage.reqs + 1
	markDirty("usage")
end

local function noteTokens(meta)
	if type(meta) ~= "table" then return 0 end
	local p = tonumber(meta.promptTokenCount) or 0
	local c = (tonumber(meta.candidatesTokenCount) or 0) + (tonumber(meta.thoughtsTokenCount) or 0)
	local total = tonumber(meta.totalTokenCount) or (p + c)
	Usage.promptTokens = Usage.promptTokens + p
	Usage.outTokens = Usage.outTokens + c
	Usage.tokens = Usage.tokens + total
	markDirty("usage")
	return p
end

