local BLOCKED_GLOBALS = {
	getgenv = true, getrenv = true, getreg = true, request = true, http_request = true, http = true,
	syn = true, fluxus = true, writefile = true, readfile = true, appendfile = true, delfile = true,
	listfiles = true, makefolder = true, delfolder = true, loadfile = true, dofile = true,
	setclipboard = true, toclipboard = true, set_clipboard = true, isfile = true, isfolder = true,
	queue_on_teleport = true, hookfunction = true, hookmetamethod = true, getrawmetatable = true,
	setrawmetatable = true, Clipboard = true,
}
local BLOCKED_TEXT = {
	"HttpService", "HttpGet", "HttpPost", "http_request", "writefile", "readfile", "appendfile", "delfile",
	"getgenv", "setclipboard", "toclipboard", "queue_on_teleport", "TeleportService", "hookfunction",
	"hookmetamethod", "getrawmetatable", "loadfile", "dofile", "AnonimoAI", "PromptPurchase", "PromptProductPurchase",
}

local function staticScan(code)
	for _, word in ipairs(BLOCKED_TEXT) do
		if code:find(word, 1, true) then return "uso de '" .. word .. "' e bloqueado por seguranca" end
	end
	return nil
end

local function sandboxEnv()
	local base = (getfenv and getfenv(1)) or _G
	return setmetatable({}, {
		__index = function(_, k)
			if BLOCKED_GLOBALS[k] then return nil end
			return base[k]
		end,
	})
end

