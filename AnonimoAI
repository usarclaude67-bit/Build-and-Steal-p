local Vision = { shotFails = 0, shotDisabled = false, lastMethod = "nenhum" }
local guiRef -- definido quando a GUI existir (para esconder no print)

local function regionName(c, r, cols, rows)
	local h = (c <= cols / 3) and "esquerda" or ((c <= cols * 2 / 3) and "centro" or "direita")
	local v = (r <= rows / 3) and "cima" or ((r <= rows * 2 / 3) and "meio" or "baixo")
	return v .. "/" .. h
end

local function sceneScan()
	local cam = workspace.CurrentCamera
	if not cam then return "(sem camera)" end
	local L = {}
	local function add(s) L[#L + 1] = s end
	local cf = cam.CFrame
	local look = cf.LookVector
	add(("Camera: pos (%.0f, %.0f, %.0f) | direcao (%.2f, %.2f, %.2f) | FOV %.0f"):format(
		cf.Position.X, cf.Position.Y, cf.Position.Z, look.X, look.Y, look.Z, cam.FieldOfView))
	add(("Hora do jogo: %.1f | Gravidade: %.1f"):format(Lighting.ClockTime, workspace.Gravity))

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if LocalPlayer.Character then ignore[#ignore + 1] = LocalPlayer.Character end
	params.FilterDescendantsInstances = ignore

	local vp = cam.ViewportSize
	local cols, rows = 9, 5
	local seen, order, sky = {}, {}, 0
	for r = 1, rows do
		for c = 1, cols do
			local ray = cam:ViewportPointToRay(vp.X * (c - 0.5) / cols, vp.Y * (r - 0.5) / rows)
			local res = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
			if res and res.Instance then
				local inst = res.Instance
				local model = inst:FindFirstAncestorOfClass("Model")
				local label = (model and model ~= workspace) and model.Name or inst.Name
				local e = seen[label]
				if not e then
					e = { n = 0, dist = 0, class = inst.ClassName, mat = tostring(res.Material), regions = {} }
					seen[label] = e
					order[#order + 1] = label
				end
				e.n = e.n + 1
				e.dist = e.dist + res.Distance
				e.regions[regionName(c, r, cols, rows)] = true
			else
				sky = sky + 1
			end
		end
	end
	table.sort(order, function(a, b) return seen[a].n > seen[b].n end)
	add(("Grade de visao %dx%d: %d celulas de ceu/vazio"):format(cols, rows, sky))
	for i = 1, math.min(12, #order) do
		local e = seen[order[i]]
		local regs = {}
		for k in pairs(e.regions) do regs[#regs + 1] = k end
		table.sort(regs)
		add(("  - %s [%s, %s] %d celulas, ~%.0f studs, em: %s"):format(
			order[i], e.class, e.mat:gsub("Enum.Material.", ""), e.n, e.dist / e.n, table.concat(regs, ", ")))
	end

	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local pt, onScreen = cam:WorldToViewportPoint(hrp.Position)
				if onScreen and pt.Z > 0 then
					add(("Jogador na tela: %s a %.0f studs"):format(p.DisplayName, (hrp.Position - cf.Position).Magnitude))
				end
			end
		end
	end

	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg then
		local texts, n = {}, 0
		for _, g in ipairs(pg:GetDescendants()) do
			if n >= 20 then break end
			if (g:IsA("TextLabel") or g:IsA("TextButton")) and g.Visible and g.Text ~= "" and #g.Text < 100 and g.TextTransparency < 1 then
				local sg = g:FindFirstAncestorOfClass("ScreenGui")
				if sg and sg.Enabled and sg.Name ~= CONFIG.GUI_NAME then
					texts[#texts + 1] = shorten(g.Text, 60)
					n = n + 1
				end
			end
		end
		if #texts > 0 then add("Textos de interface visiveis: " .. table.concat(texts, " | ")) end
	end
	return table.concat(L, "\n")
end

-- ---- PNG (deflate "stored") + Base64, sem dependencias ----
local CRC_TABLE
local function crcTable()
	if CRC_TABLE then return CRC_TABLE end
	local t = {}
	for i = 0, 255 do
		local c = i
		for _ = 1, 8 do
			if bit32.band(c, 1) == 1 then
				c = bit32.bxor(0xEDB88320, bit32.rshift(c, 1))
			else
				c = bit32.rshift(c, 1)
			end
		end
		t[i] = c
	end
	CRC_TABLE = t
	return t
end

local lastYield = os.clock()
local function maybeYield()
	if os.clock() - lastYield > 0.006 then
		task.wait()
		lastYield = os.clock()
	end
end

local function crc32(buf, from, to)
	local t = crcTable()
	local c = 0xFFFFFFFF
	for i = from, to - 1 do
		c = bit32.bxor(t[bit32.band(bit32.bxor(c, buffer.readu8(buf, i)), 0xFF)], bit32.rshift(c, 8))
		if i % 16384 == 0 then maybeYield() end
	end
	return bit32.bxor(c, 0xFFFFFFFF)
end

local function writeU32BE(buf, off, v)
	buffer.writeu8(buf, off, bit32.band(bit32.rshift(v, 24), 255))
	buffer.writeu8(buf, off + 1, bit32.band(bit32.rshift(v, 16), 255))
	buffer.writeu8(buf, off + 2, bit32.band(bit32.rshift(v, 8), 255))
	buffer.writeu8(buf, off + 3, bit32.band(v, 255))
end

-- raw = buffer com h linhas de (1 byte de filtro=0 + w*3 bytes RGB)
local function encodePNG(raw, w, h)
	local rawLen = buffer.len(raw)
	local nBlocks = math.ceil(rawLen / 65535)
	local zLen = 2 + rawLen + nBlocks * 5 + 4
	local out = buffer.create(8 + 25 + (12 + zLen) + 12)
	local sig = { 137, 80, 78, 71, 13, 10, 26, 10 }
	for i = 1, 8 do buffer.writeu8(out, i - 1, sig[i]) end
	local pos = 8

	writeU32BE(out, pos, 13); pos = pos + 4
	local typeStart = pos
	buffer.writestring(out, pos, "IHDR"); pos = pos + 4
	writeU32BE(out, pos, w); writeU32BE(out, pos + 4, h); pos = pos + 8
	buffer.writeu8(out, pos, 8)      -- profundidade
	buffer.writeu8(out, pos + 1, 2)  -- RGB
	buffer.writeu8(out, pos + 2, 0)
	buffer.writeu8(out, pos + 3, 0)
	buffer.writeu8(out, pos + 4, 0)
	pos = pos + 5
	writeU32BE(out, pos, crc32(out, typeStart, pos)); pos = pos + 4

	writeU32BE(out, pos, zLen); pos = pos + 4
	typeStart = pos
	buffer.writestring(out, pos, "IDAT"); pos = pos + 4
	buffer.writeu8(out, pos, 0x78)
	buffer.writeu8(out, pos + 1, 0x01)
	pos = pos + 2
	local a, b, offset = 1, 0, 0
	while offset < rawLen do
		local n = math.min(65535, rawLen - offset)
		local nn = bit32.band(bit32.bnot(n), 0xFFFF)
		buffer.writeu8(out, pos, (offset + n >= rawLen) and 1 or 0)
		buffer.writeu8(out, pos + 1, bit32.band(n, 255))
		buffer.writeu8(out, pos + 2, bit32.rshift(n, 8))
		buffer.writeu8(out, pos + 3, bit32.band(nn, 255))
		buffer.writeu8(out, pos + 4, bit32.rshift(nn, 8))
		pos = pos + 5
		buffer.copy(out, pos, raw, offset, n)
		for i = offset, offset + n - 1 do
			a = (a + buffer.readu8(raw, i)) % 65521
			b = (b + a) % 65521
			if i % 16384 == 0 then maybeYield() end
		end
		pos = pos + n
		offset = offset + n
	end
	writeU32BE(out, pos, b * 65536 + a); pos = pos + 4
	writeU32BE(out, pos, crc32(out, typeStart, pos)); pos = pos + 4

	writeU32BE(out, pos, 0); pos = pos + 4
	typeStart = pos
	buffer.writestring(out, pos, "IEND"); pos = pos + 4
	writeU32BE(out, pos, crc32(out, typeStart, pos))
	return out
end

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64BYTES = {}
for i = 1, 64 do B64BYTES[i - 1] = B64:byte(i) end

local function base64Encode(buf)
	local len = buffer.len(buf)
	local out = buffer.create(math.ceil(len / 3) * 4)
	local o = 0
	for i = 0, len - 1, 3 do
		local b1 = buffer.readu8(buf, i)
		local b2 = (i + 1 < len) and buffer.readu8(buf, i + 1) or 0
		local b3 = (i + 2 < len) and buffer.readu8(buf, i + 2) or 0
		local n = b1 * 65536 + b2 * 256 + b3
		buffer.writeu8(out, o, B64BYTES[bit32.rshift(n, 18)])
		buffer.writeu8(out, o + 1, B64BYTES[bit32.band(bit32.rshift(n, 12), 63)])
		buffer.writeu8(out, o + 2, (i + 1 < len) and B64BYTES[bit32.band(bit32.rshift(n, 6), 63)] or 61)
		buffer.writeu8(out, o + 3, (i + 2 < len) and B64BYTES[bit32.band(n, 63)] or 61)
		o = o + 4
		if i % 12288 == 0 then maybeYield() end
	end
	return buffer.tostring(out)
end

-- Captura a tela via CaptureService -> EditableImage -> PNG base64
local function captureScreenshot()
	if not CaptureService or not AssetService then return nil, "CaptureService/AssetService indisponivel" end
	local contentId, done = nil, false
	local hidden = false
	if CONFIG.HIDE_UI_ON_CAPTURE and guiRef then
		guiRef.Enabled = false
		hidden = true
		RunService.RenderStepped:Wait()
	end
	local okCall, errCall = pcall(function()
		CaptureService:CaptureScreenshot(function(id)
			contentId, done = id, true
		end)
	end)
	local t0 = os.clock()
	while okCall and not done and os.clock() - t0 < CONFIG.VISION_TIMEOUT do task.wait() end
	if hidden then guiRef.Enabled = true end
	if not okCall then return nil, "CaptureScreenshot falhou: " .. tostring(errCall) end
	if not contentId then return nil, "timeout ao capturar a tela" end

	local okImg, img = pcall(function()
		local okA, r = pcall(function() return AssetService:CreateEditableImageAsync(Content.fromUri(contentId)) end)
		if okA then return r end
		return AssetService:CreateEditableImageAsync(contentId)
	end)
	if not okImg or not img then return nil, "EditableImage indisponivel: " .. tostring(img) end

	local okRun, b64, w, h = pcall(function()
		local size = img.Size
		local tw = math.min(CONFIG.VISION_WIDTH, size.X)
		local th = math.max(1, math.floor(size.Y * tw / size.X))
		pcall(function() img:Resize(Vector2.new(tw, th)) end)
		local s2 = img.Size
		local sw, sh = s2.X, s2.Y
		if sw > tw then
			-- Resize indisponivel: amostragem por vizinho mais proximo
			sw, sh = s2.X, s2.Y
		else
			tw, th = sw, sh
		end
		local pixels = img:ReadPixelsBuffer(Vector2.new(0, 0), s2)
		local stride = 1 + tw * 3
		local raw = buffer.create(th * stride)
		for y = 0, th - 1 do
			local sy = math.min(sh - 1, math.floor(y * sh / th))
			local rowBase = y * stride
			buffer.writeu8(raw, rowBase, 0)
			for x = 0, tw - 1 do
				local sx = math.min(sw - 1, math.floor(x * sw / tw))
				local si = (sy * sw + sx) * 4
				local di = rowBase + 1 + x * 3
				buffer.writeu8(raw, di, buffer.readu8(pixels, si))
				buffer.writeu8(raw, di + 1, buffer.readu8(pixels, si + 1))
				buffer.writeu8(raw, di + 2, buffer.readu8(pixels, si + 2))
			end
			if y % 8 == 0 then maybeYield() end
		end
		return base64Encode(encodePNG(raw, tw, th)), tw, th
	end)
	pcall(function() img:Destroy() end)
	if not okRun then return nil, "falha ao codificar PNG: " .. tostring(b64) end
	return b64, w, h
end

-- Retorna { image = b64|nil, w, h, scan = texto, method = "print+cena"|"cena" }
local function visionSnapshot(forceShot)
	local snap = { scan = "", method = "cena" }
	if forceShot then
		Vision.shotDisabled, Vision.shotFails = false, 0
	end
	if not Vision.shotDisabled then
		local b64, w, h = captureScreenshot()
		if b64 then
			snap.image, snap.w, snap.h, snap.method = b64, w, h, "print+cena"
			Vision.shotFails = 0
		else
			Vision.shotFails = Vision.shotFails + 1
			snap.shotError = w
			if Vision.shotFails >= 2 then Vision.shotDisabled = true end
		end
	end
	local okS, scan = pcall(sceneScan)
	snap.scan = okS and scan or ("(varredura falhou: " .. tostring(scan) .. ")")
	Vision.lastMethod = snap.method
	return snap
end

