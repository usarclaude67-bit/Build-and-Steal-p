local State = { busy = false, activeModel = nil, noThinking = false }

local function httpPost(url, headers, body)
	local req = { Url = url, Method = "POST", Headers = headers, Body = body }
	local ok, res
	if httpRequest then
		ok, res = pcall(httpRequest, req)
	else
		ok, res = pcall(function() return HttpService:RequestAsync(req) end)
	end
	if not ok then return false, 0, tostring(res) end
	if type(res) ~= "table" then return false, 0, "resposta invalida" end
	return true, res.StatusCode or res.status_code or 0, res.Body or res.body or ""
end

local function buildToolsDecl()
	local decls = {}
	for _, name in ipairs(ToolOrder) do decls[#decls + 1] = Tools[name].decl end
	return { { functionDeclarations = decls } }
end

