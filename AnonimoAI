local Spawn = { folder = nil }
local function getFolder()
	if Spawn.folder and Spawn.folder.Parent then return Spawn.folder end
	local f = workspace:FindFirstChild(CONFIG.SPAWN_FOLDER)
	if not f then
		f = Instance.new("Folder")
		f.Name = CONFIG.SPAWN_FOLDER
		f.Parent = workspace
	end
	Spawn.folder = f
	return f
end

local function myRig()
	local ch = LocalPlayer.Character
	if not ch then return nil end
	return ch, ch:FindFirstChild("HumanoidRootPart"), ch:FindFirstChildOfClass("Humanoid")
end

local function groundY(pos, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(pos + Vector3.new(0, 12, 0), Vector3.new(0, -80, 0), params)
	return hit and hit.Position.Y or nil
end

-- ponto a `distance` studs a frente do jogador; retorna pos, groundY, root  (ou nil, erro)
local function frontPoint(distance)
	local ch, root = myRig()
	if not root then return nil, "personagem nao encontrado" end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
	local pos = root.Position + flat.Unit * distance
	return pos, groundY(pos, { ch, getFolder() }), root
end

local COLOR_NAMES = {
	vermelho = Color3.fromRGB(230, 50, 50), red = Color3.fromRGB(230, 50, 50),
	azul = Color3.fromRGB(50, 100, 230), blue = Color3.fromRGB(50, 100, 230),
	verde = Color3.fromRGB(50, 190, 90), green = Color3.fromRGB(50, 190, 90),
	amarelo = Color3.fromRGB(245, 215, 50), yellow = Color3.fromRGB(245, 215, 50),
	laranja = Color3.fromRGB(245, 140, 40), orange = Color3.fromRGB(245, 140, 40),
	roxo = Color3.fromRGB(140, 90, 240), purple = Color3.fromRGB(140, 90, 240),
	rosa = Color3.fromRGB(240, 100, 170), pink = Color3.fromRGB(240, 100, 170),
	preto = Color3.fromRGB(20, 20, 20), black = Color3.fromRGB(20, 20, 20),
	branco = Color3.fromRGB(245, 245, 245), white = Color3.fromRGB(245, 245, 245),
	cinza = Color3.fromRGB(150, 150, 155), gray = Color3.fromRGB(150, 150, 155),
	marrom = Color3.fromRGB(120, 80, 50), brown = Color3.fromRGB(120, 80, 50),
	ciano = Color3.fromRGB(40, 200, 220), cyan = Color3.fromRGB(40, 200, 220),
}

local function parseColor(s)
	if not s or tostring(s) == "" then return nil end
	s = trim(tostring(s):lower())
	if COLOR_NAMES[s] then return COLOR_NAMES[s] end
	local hex = s:match("^#?(%x%x%x%x%x%x)$")
	if hex then
		return Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16))
	end
	local ok, c = pcall(function() return BrickColor.new(s).Color end)
	if ok and c then return c end
	return nil
end

local MATERIAL_PT = {
	madeira = "Wood", metal = "Metal", vidro = "Glass", tijolo = "Brick", concreto = "Concrete",
	plastico = "Plastic", plástico = "Plastic", grama = "Grass", gelo = "Ice", areia = "Sand", pedra = "Slate",
}
local function parseMaterial(name)
	if not name or tostring(name) == "" then return nil end
	local low = tostring(name):lower():gsub("%s", "")
	low = MATERIAL_PT[low] and MATERIAL_PT[low]:lower() or low
	for _, item in ipairs(Enum.Material:GetEnumItems()) do
		if item.Name:lower() == low then return item end
	end
	return nil
end

local function buildBlockDummy()
	local m = Instance.new("Model")
	m.Name = "NPC"
	local function part(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name, p.Size, p.Color = name, size, color
		p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		p.CFrame = CFrame.new(offset)
		p.Parent = m
		return p
	end
	local skin, shirt, pants = Color3.fromRGB(245, 205, 48), Color3.fromRGB(13, 105, 172), Color3.fromRGB(80, 160, 90)
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), shirt)
	root.Transparency = 1
	local limbs = {
		part("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), shirt),
		part("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), skin),
		part("Left Arm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 0, 0), skin),
		part("Right Arm", Vector3.new(1, 2, 1), Vector3.new(1.5, 0, 0), skin),
		part("Left Leg", Vector3.new(1, 2, 1), Vector3.new(-0.5, -2, 0), pants),
		part("Right Leg", Vector3.new(1, 2, 1), Vector3.new(0.5, -2, 0), pants),
	}
	for _, p in ipairs(limbs) do
		local w = Instance.new("WeldConstraint")
		w.Part0, w.Part1, w.Parent = root, p, p
		p.CanCollide = false
	end
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = 2
	hum.Parent = m
	m.PrimaryPart = root
	return m
end

local function buildNpcModel(appearance)
	appearance = tostring(appearance or "noob")
	local lower = appearance:lower()
	local ok, model = pcall(function()
		local desc
		if lower == "clone" then
			desc = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
		elseif lower ~= "noob" and lower ~= "" then
			desc = Players:GetHumanoidDescriptionFromUserId(Players:GetUserIdFromNameAsync(appearance))
		else
			desc = Instance.new("HumanoidDescription")
		end
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and model then return model, "avatar" end

	local ch = LocalPlayer.Character
	if ch then
		local prev = ch.Archivable
		ch.Archivable = true
		local okc, clone = pcall(function() return ch:Clone() end)
		ch.Archivable = prev
		if okc and clone then
			for _, d in ipairs(clone:GetDescendants()) do
				if d:IsA("LocalScript") or d:IsA("Script") then d:Destroy() end
			end
			return clone, "clone do seu personagem"
		end
	end
	return buildBlockDummy(), "boneco de blocos"
end

local function attachBubble(model, text, seconds)
	local adornee = model:FindFirstChild("Head") or model.PrimaryPart
	if not adornee then return end
	local bb = new("BillboardGui", {
		Size = UDim2.fromOffset(220, 44), StudsOffset = Vector3.new(0, 3.2, 0),
		AlwaysOnTop = true, Adornee = adornee,
	})
	local lbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(20, 20, 26), BackgroundTransparency = 0.2,
		Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = Color3.new(1, 1, 1),
		TextWrapped = true, Text = tostring(text),
	}, bb)
	corner(lbl, 10)
	bb.Parent = adornee
	task.delay(seconds or 8, function() if bb then bb:Destroy() end end)
end

defTool("spawn_npc",
	"Cria um NPC humanoide LOCAL (so o usuario ve) na frente do jogador, virado para ele.",
	{
		name = { type = "STRING", description = "Nome exibido acima do NPC" },
		distance = { type = "NUMBER", description = "Distancia em studs a frente do jogador (padrao 8)" },
		appearance = { type = "STRING", description = "'noob' (padrao), 'clone' (copia do jogador) ou um nome de usuario Roblox" },
		say = { type = "STRING", description = "Fala opcional exibida em balao sobre o NPC" },
		follow = { type = "BOOLEAN", description = "Se true, o NPC segue o jogador" },
	},
	function(a)
		local dist = math.clamp(tonumber(a.distance) or 8, 2, 120)
		local pos, gy, root = frontPoint(dist)
		if not pos then return false, gy end
		local model, how = buildNpcModel(a.appearance)
		local name = (a.name and tostring(a.name) ~= "") and tostring(a.name) or "NPC"
		model.Name = name
		local hum = model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.DisplayName = name
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
		end
		model.Parent = getFolder()
		local hrp = model:FindFirstChild("HumanoidRootPart")
		if hrp and not model.PrimaryPart then model.PrimaryPart = hrp end

		local base = gy or (root.Position.Y - 3)
		local at = Vector3.new(pos.X, base + 5, pos.Z)
		model:PivotTo(CFrame.lookAt(at, Vector3.new(root.Position.X, at.Y, root.Position.Z)))
		local bbCf, bbSize = model:GetBoundingBox()
		local bottom = bbCf.Position.Y - bbSize.Y / 2
		model:PivotTo(model:GetPivot() + Vector3.new(0, base - bottom + 0.05, 0))

		if a.say and tostring(a.say) ~= "" then attachBubble(model, a.say, 8) end
		if a.follow and hum and hrp then
			task.spawn(function()
				while model.Parent and hum.Health > 0 do
					local _, r = myRig()
					if r then
						local away = (hrp.Position - r.Position)
						if away.Magnitude > 5 then hum:MoveTo(r.Position + away.Unit * 4) end
					end
					task.wait(0.4)
				end
			end)
		end
		return true, ("NPC '%s' criado a %d studs a sua frente (%s)%s."):format(
			name, math.floor(dist), how, a.follow and ", seguindo voce" or "")
	end)

defTool("spawn_part",
	"Cria uma peca 3D LOCAL (so o usuario ve) na frente do jogador.",
	{
		shape = { type = "STRING", description = "block | ball | cylinder | wedge (padrao block)" },
		size_x = { type = "NUMBER", description = "Largura em studs (padrao 4)" },
		size_y = { type = "NUMBER", description = "Altura em studs (padrao 4)" },
		size_z = { type = "NUMBER", description = "Profundidade em studs (padrao 4)" },
		color = { type = "STRING", description = "Nome da cor (vermelho, azul...) ou hex #RRGGBB" },
		material = { type = "STRING", description = "Material (Plastic, Neon, Wood, Metal, Glass...)" },
		distance = { type = "NUMBER", description = "Distancia a frente do jogador (padrao 8)" },
		elevation = { type = "NUMBER", description = "Studs acima do chao (padrao 0)" },
		anchored = { type = "BOOLEAN", description = "Fixa no ar (padrao true)" },
		transparency = { type = "NUMBER", description = "0 (solido) a 1 (invisivel)" },
		name = { type = "STRING", description = "Nome da peca" },
	},
	function(a)
		local dist = math.clamp(tonumber(a.distance) or 8, 2, 120)
		local pos, gy, root = frontPoint(dist)
		if not pos then return false, gy end
		local sx = math.clamp(tonumber(a.size_x) or 4, 0.2, 300)
		local sy = math.clamp(tonumber(a.size_y) or 4, 0.2, 300)
		local sz = math.clamp(tonumber(a.size_z) or 4, 0.2, 300)
		local shape = tostring(a.shape or "block"):lower()
		local class = (shape == "wedge" or shape == "cunha") and "WedgePart" or "Part"
		local p = Instance.new(class)
		if class == "Part" then
			if shape == "ball" or shape == "sphere" or shape == "esfera" then
				p.Shape = Enum.PartType.Ball
			elseif shape == "cylinder" or shape == "cilindro" then
				p.Shape = Enum.PartType.Cylinder
			end
		end
		p.Name = (a.name and tostring(a.name) ~= "") and tostring(a.name) or "Peca"
		p.Size = Vector3.new(sx, sy, sz)
		p.Anchored = a.anchored ~= false
		p.Color = parseColor(a.color) or Color3.fromRGB(163, 162, 165)
		local mat = parseMaterial(a.material)
		if mat then p.Material = mat end
		p.Transparency = math.clamp(tonumber(a.transparency) or 0, 0, 1)
		local base = gy or (root.Position.Y - 3)
		p.CFrame = CFrame.new(pos.X, base + sy / 2 + (tonumber(a.elevation) or 0), pos.Z)
		p.Parent = getFolder()
		return true, ("Peca '%s' (%s, %.0fx%.0fx%.0f) criada a %d studs a sua frente."):format(
			p.Name, shape, sx, sy, sz, math.floor(dist))
	end)

