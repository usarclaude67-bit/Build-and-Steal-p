function refreshHistory()
	for _, c in ipairs(histList:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	local q = searchBox.Text:lower()
	local list = {}
	for _, m in ipairs(Index) do
		if q == "" or (m.title or ""):lower():find(q, 1, true) then list[#list + 1] = m end
	end
	table.sort(list, function(a, b) return (a.updated or 0) > (b.updated or 0) end)
	if #list == 0 then
		local empty = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, histList)
		createText(empty, "Nenhuma conversa ainda.", 1, { color = THEME.subtext, size = 12, align = Enum.TextXAlignment.Center })
		return
	end
	for i, m in ipairs(list) do
		local active = Current and Current.id == m.id
		local item = new("Frame", {
			LayoutOrder = i, Size = UDim2.new(1, 0, 0, 46),
			BackgroundColor3 = active and THEME.accent or THEME.panel, BackgroundTransparency = active and 0.55 or 0.3,
			BorderSizePixel = 0,
		}, histList)
		corner(item, 12)
		local open = new("TextButton", {
			Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, -44, 1, 0),
		}, item)
		new("TextLabel", {
			Text = m.title or "Chat", Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = THEME.text,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -20, 0, 18),
		}, open)
		new("TextLabel", {
			Text = ("%s · %d msgs"):format(fmtDate(m.updated), tonumber(m.count) or 0), Font = Enum.Font.Gotham,
			TextSize = 10, TextColor3 = THEME.subtext, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 25), Size = UDim2.new(1, -20, 0, 14),
		}, open)
		open.Activated:Connect(function()
			local c = loadChat(m.id)
			if c then
				openChat(c)
				setDrawer(false)
			else
				notice("⚠ Não foi possível carregar essa conversa.")
			end
		end)
		local del = iconButton(item, "🗑", 28, 12, 0)
		del.AnchorPoint, del.Position = Vector2.new(1, 0.5), UDim2.new(1, -8, 0.5, 0)
		local armed = false
		del.Activated:Connect(function()
			if not armed then
				armed = true
				del.Text = "?"
				task.delay(2, function()
					armed = false
					if del.Parent then del.Text = "🗑" end
				end)
			else
				deleteChat(m.id)
				refreshHistory()
			end
		end)
	end
end

