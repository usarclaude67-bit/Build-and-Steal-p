local function createCodeBlock(parent, lang, code, order)
	code = code:gsub("\t", "    ")
	local block = new("Frame", {
		Name = "CodeBlock", LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.codeBg, BackgroundTransparency = 0.05, BorderSizePixel = 0,
	}, parent)
	corner(block, 10)
	stroke(block, Color3.new(1, 1, 1), 0.9)
	listLayout(block, Enum.FillDirection.Vertical, 0)

	local header = new("Frame", { Name = "Header", LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, block)
	new("TextLabel", {
		Text = (lang ~= "" and lang or "código"), Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = THEME.subtext,
		TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -52, 1, 0),
	}, header)
	local copyBtn = iconButton(header, "📋", 22, 11, 0)
	copyBtn.AnchorPoint, copyBtn.Position = Vector2.new(1, 0.5), UDim2.new(1, -6, 0.5, 0)
	copyBtn.Activated:Connect(function() flash(copyBtn, copyToClipboard(code)) end)

	new("Frame", {
		Name = "Line", LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.92, BorderSizePixel = 0,
	}, block)

	local content = new("Frame", {
		Name = "Content", LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
	}, block)
	padding(content, 8, 10, 8, 10)
	listLayout(content, Enum.FillDirection.Vertical, 0)

	local useHighlight = (lang == "" or lang == "lua" or lang == "luau")
	for idx, chunk in ipairs(chunkCode(code, 1400)) do
		local rich = useHighlight and highlightLua(chunk) or escapeRich(chunk)
		if #rich > 15000 then rich = escapeRich(chunk) end
		new("TextLabel", {
			Name = "Code", LayoutOrder = idx, BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			Font = Enum.Font.Code, TextSize = 12, TextColor3 = THEME.code,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true, RichText = true, Text = rich,
		}, content)
	end
	return block
end

