-- ═══════════════════════ HELPERS ═══════════════════════
local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	if parent then inst.Parent = parent end
	return inst
end

local function corner(inst, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
end

local function stroke(inst, color, transparency, thickness)
	return new("UIStroke", {
		Color = color or Color3.new(1, 1, 1),
		Transparency = transparency or 0.88,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

local function padding(inst, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top), PaddingRight = UDim.new(0, right),
		PaddingBottom = UDim.new(0, bottom), PaddingLeft = UDim.new(0, left),
	}, inst)
end

local function listLayout(parent, dir, pad, order)
	return new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		SortOrder = order or Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, pad or 0),
	}, parent)
end

local function tween(inst, duration, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(duration, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function trim(s)
	return (s:gsub("^%s+", ""):gsub("%s+$", ""))
end

local function escapeRich(s)
	s = s:gsub("&", "&amp;")
	s = s:gsub("<", "&lt;")
	s = s:gsub(">", "&gt;")
	s = s:gsub('"', "&quot;")
	s = s:gsub("'", "&apos;")
	return s
end

local function splitLong(s, maxLen)
	if #s <= maxLen then return { s } end
	local out, cur = {}, ""
	for line in (s .. "\n"):gmatch("(.-)\n") do
		if #cur + #line + 1 > maxLen and cur ~= "" then
			out[#out + 1] = cur
			cur = ""
		end
		cur = (cur == "") and line or (cur .. "\n" .. line)
	end
	if cur ~= "" then out[#out + 1] = cur end
	return out
end

local function fmtNum(n)
	n = tonumber(n) or 0
	if n >= 1000000 then return ("%.1fM"):format(n / 1000000) end
	if n >= 1000 then return ("%.1fk"):format(n / 1000) end
	return tostring(math.floor(n))
end

local function shorten(s, n)
	s = trim((s:gsub("%s+", " ")))
	if #s <= n then return s end
	return s:sub(1, n - 1) .. "…"
end

local function fmtDate(ts)
	if not ts then return "" end
	return os.date("%d/%m %H:%M", ts)
end

local function newId()
	return "c" .. tostring(os.time()) .. tostring(math.random(100, 999))
end

