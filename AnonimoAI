local Context = { text = "", stamp = 0, building = false, gameName = nil }

local function getGameName()
	if Context.gameName then return Context.gameName end
	local name = game.Name
	if game.PlaceId ~= 0 then
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, game.PlaceId)
		if ok and type(info) == "table" and info.Name then name = info.Name end
	end
	Context.gameName = name
	return name
end

local function collectServerContext()
	local L = {}
	local function add(s) L[#L + 1] = s end

	add("Jogo: " .. getGameName())
	add("PlaceId: " .. tostring(game.PlaceId) .. " | GameId: " .. tostring(game.GameId))
	add("JobId: " .. (game.JobId ~= "" and game.JobId or "(Studio/local)"))
	add(("Tempo de servidor: %.1f min"):format(workspace.DistributedGameTime / 60))

	local list = Players:GetPlayers()
	add(("Jogadores online: %d/%d"):format(#list, Players.MaxPlayers))
	for i, p in ipairs(list) do
		if i > CONFIG.MAX_PLAYERS_IN_CTX then
			add(("  ... e mais %d jogadores"):format(#list - i + 1))
			break
		end
		local team = p.Team and p.Team.Name or "Sem equipe"
		local me = (p == LocalPlayer) and " (voce)" or ""
		add(("  %d. %s (@%s) | equipe: %s%s"):format(i, p.DisplayName, p.Name, team, me))
	end

	local okT, teamList = pcall(function() return Teams:GetTeams() end)
	if okT and #teamList > 0 then
		local t = {}
		for _, team in ipairs(teamList) do
			t[#t + 1] = ("%s (%d)"):format(team.Name, #team:GetPlayers())
		end
		add("Equipes: " .. table.concat(t, ", "))
	end

	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		add(("Posicao do jogador local: %.0f, %.0f, %.0f"):format(root.Position.X, root.Position.Y, root.Position.Z))
	end

	local total, classes = 0, {}
	for _, inst in ipairs(workspace:GetDescendants()) do
		total = total + 1
		local cn = inst.ClassName
		classes[cn] = (classes[cn] or 0) + 1
		if total % 20000 == 0 then task.wait() end
	end
	add("Instancias no Workspace: " .. total)
	add("Filhos diretos do Workspace: " .. #workspace:GetChildren())

	local arr = {}
	for cn, n in pairs(classes) do arr[#arr + 1] = { cn, n } end
	table.sort(arr, function(a, b) return a[2] > b[2] end)
	local top = {}
	for i = 1, math.min(8, #arr) do top[i] = arr[i][1] .. "=" .. arr[i][2] end
	if #top > 0 then add("Classes mais comuns: " .. table.concat(top, ", ")) end
	add("Gravidade: " .. tostring(workspace.Gravity) .. " | ClockTime: " .. ("%.1f"):format(Lighting.ClockTime))
	return table.concat(L, "\n")
end

local function buildServerContext(force)
	if not force and Context.text ~= "" and (os.clock() - Context.stamp) < CONFIG.CONTEXT_TTL then
		return Context.text
	end
	if Context.building then
		while Context.building do task.wait() end
		return Context.text
	end
	Context.building = true
	local ok, result = pcall(collectServerContext)
	Context.building = false
	if ok then
		Context.text, Context.stamp = result, os.clock()
	elseif Context.text == "" then
		Context.text = "(falha ao coletar contexto: " .. tostring(result) .. ")"
	end
	return Context.text
end

