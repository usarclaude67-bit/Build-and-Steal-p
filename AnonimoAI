		doSubmit(text)
	end
end

-- Paleta: sugestoes ao digitar "/" -----------------------------
local function updatePalette()
	for _, c in ipairs(palette:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	local text = inputBox.Text
	if text:sub(1, 1) ~= "/" or text:find("%s") then
		palette.Visible = false
		return
	end
	local q = text:sub(2):lower()
	local n = 0
	for _, def in ipairs(COMMANDS) do
		if (not def.roblox or Settings.roblox) and def[1]:sub(1, #q) == q then
			n = n + 1
			if n > 5 then break end
			local b = new("TextButton", {
				LayoutOrder = n, AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28),
				Text = "", ZIndex = 6,
			}, palette)
			corner(b, 8)
			new("TextLabel", {
				RichText = true, BackgroundTransparency = 1, Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0),
				Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = THEME.text, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6,
				Text = ("<b>/%s</b>  <font color=\"#9696A6\">%s</font>"):format(def[1], escapeRich(def[2])),
			}, b)
			b.Activated:Connect(function()
				inputBox.Text = "/" .. def[1] .. " "
				inputBox:CaptureFocus()
			end)
		end
	end
	palette.Visible = n > 0
end

-- ═══════════════════════ ARRASTE / MINIMIZAR / TECLADO ═══════════════════════
local kbSaved = nil

local function clampMain(x, y, w, h)
	local sc = gui.AbsoluteSize
	w, h = w or W, h or main.AbsoluteSize.Y
	return math.clamp(x, 4, math.max(4, sc.X - w - 4)), math.clamp(y, 4, math.max(4, sc.Y - h - 4))
end

do
	local dragging, dragInput, dragStart = false, nil, Vector3.new(0, 0, 0)
	local startX, startY = 0, 0
	topbar.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging, dragInput, dragStart = true, input, input.Position
			startX, startY = main.Position.X.Offset, main.Position.Y.Offset
			if kbSaved then kbSaved.y = nil end
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if conn then conn:Disconnect() end
				end
			end)
		end
	end)
	bind(UserInputService.InputChanged, function(input)
		if not dragging then return end
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseMovement or (t == Enum.UserInputType.Touch and input == dragInput) then
			local d = input.Position - dragStart
			local x, y = clampMain(startX + d.X, startY + d.Y)
			main.Position = UDim2.fromOffset(x, y)
		end
	end)
	bind(UserInputService.InputEnded, function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or (t == Enum.UserInputType.Touch and input == dragInput) then
			dragging = false
		end
	end)
end

bind(gui:GetPropertyChangedSignal("AbsoluteSize"), function()
	local x, y = clampMain(main.Position.X.Offset, main.Position.Y.Offset)
	main.Position = UDim2.fromOffset(x, y)
end)

local function fitAboveKeyboard()
	if minimized or not inputBox:IsFocused() then return end
	if not UserInputService.OnScreenKeyboardVisible then return end
	local kbTop = UserInputService.OnScreenKeyboardPosition.Y
	if main.AbsolutePosition.Y + main.AbsoluteSize.Y <= kbTop - 8 then return end
	if not kbSaved then kbSaved = { y = main.Position.Y.Offset, h = expandedH } end
	local newH = math.clamp(kbTop - 16, MIN_H, expandedH)
	local newY = math.max(4, kbTop - newH - 8)
	tween(main, 0.25, {
		Size = UDim2.fromOffset(W, newH),
		Position = UDim2.fromOffset(main.Position.X.Offset, newY),
	})
end

local function restoreFromKeyboard()
	if not kbSaved then return end
	local saved = kbSaved
	kbSaved = nil
	local x, y = clampMain(main.Position.X.Offset, saved.y or main.Position.Y.Offset, W, saved.h)
	tween(main, 0.25, { Size = UDim2.fromOffset(W, saved.h), Position = UDim2.fromOffset(x, y) })
end

local function delayedRestore()
	task.delay(0.3, function()
		if not inputBox:IsFocused() and not UserInputService.OnScreenKeyboardVisible then restoreFromKeyboard() end
	end)
end

bind(inputBox.Focused, function() task.delay(0.35, fitAboveKeyboard) end)
bind(inputBox.FocusLost, delayedRestore)
bind(UserInputService:GetPropertyChangedSignal("OnScreenKeyboardVisible"), function()
	if UserInputService.OnScreenKeyboardVisible then
		task.delay(0.15, fitAboveKeyboard)
	else
		delayedRestore()
	end
end)

local animToken = 0
local function setMinimized(state)
	if state == minimized then return end
	minimized = state
	animToken = animToken + 1
	local token = animToken
	inputBox:ReleaseFocus()
	restoreFromKeyboard()
	if state then
		minBtn.Text = "+"
		minBtn:SetAttribute("OrigText", "+")
		setDrawer(false)
		usagePanel.Visible = false
		body.Size = UDim2.new(1, 0, 0, math.max(0, main.AbsoluteSize.Y - TOP_H))
		local tw = tween(main, 0.3, { Size = UDim2.fromOffset(W, TOP_H) })
		tw.Completed:Connect(function()
			if token == animToken and minimized then body.Visible = false end
		end)
	else
		minBtn.Text = "-"
		minBtn:SetAttribute("OrigText", "-")
		body.Size = UDim2.new(1, 0, 0, expandedH - TOP_H)
		body.Visible = true
		local goal = { Size = UDim2.fromOffset(W, expandedH) }
		local _, y = clampMain(main.Position.X.Offset, main.Position.Y.Offset, W, expandedH)
		if y ~= main.Position.Y.Offset then goal.Position = UDim2.fromOffset(main.Position.X.Offset, y) end
		local tw = tween(main, 0.3, goal)
		tw.Completed:Connect(function()
			if token == animToken and not minimized then
				body.Size = UDim2.new(1, 0, 1, -TOP_H)
				requestScroll()
			end
		end)
	end
end

