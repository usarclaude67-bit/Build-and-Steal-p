function ESP.Update(targetModel, targetPart, title, mps)
    if targetModel and targetPart then
        ESP.Highlight.Adornee = targetModel
        ESP.Billboard.Adornee = targetPart
        ESP.TextLabel.Text = title .. " 👻\n<font size='9'>MPS: " .. mps .. "</font>"
        ESP.Highlight.Enabled = true
        ESP.Billboard.Enabled = true
    else
        ESP.Highlight.Enabled = false
        ESP.Billboard.Enabled = false
    end
end

