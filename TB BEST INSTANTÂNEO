local Utils = {}
function Utils.ParseNumber(texto)
    if type(texto) ~= "string" then return 0 end
    texto = string.upper(string.gsub(texto, ",", ""))
    local numStr, sufixo = string.match(texto, "(%d+%.?%d*)%s*([A-Z]*)")
    local num = tonumber(numStr) or 0
    local multiplicadores = {K = 1e3, M = 1e6, B = 1e9, T = 1e12, QA = 1e15, QI = 1e18, SX = 1e21, SP = 1e24, OC = 1e27, NO = 1e30, DC = 1e33}
    if multiplicadores[sufixo] then num = num * multiplicadores[sufixo] end
    return num
end

local Core = { BestPet = nil, IsTeleporting = false }

function Core.Scan()
    task.spawn(function()
        while task.wait(0.8) do
            pcall(function()
                local runtimePets = Workspace:FindFirstChild("RuntimePets") or Workspace
                local melhor, maiorValor = nil, -1
                
                for _, tag in ipairs(runtimePets:GetDescendants()) do
                    if tag:IsA("BillboardGui") and (tag.Name == "ItemNameTag" or tag.Name == "PetTag") then
                        local labelMPS = tag:FindFirstChild("MPS")
                        local labelTitle = tag:FindFirstChild("TITLE") or tag:FindFirstChild("Title") or tag:FindFirstChild("Name")
                        
                        if labelMPS then
                            local txtMPS = labelMPS.ContentText ~= "" and labelMPS.ContentText or labelMPS.Text
                            local txtTitle = "Pet"
                            if labelTitle then txtTitle = labelTitle.ContentText ~= "" and labelTitle.ContentText or labelTitle.Text end
                            local valor = Utils.ParseNumber(txtMPS)
                            
                            local targetModel = tag:FindFirstAncestorOfClass("Model")
                            if targetModel then
                                local part = targetModel.PrimaryPart or targetModel:FindFirstChildWhichIsA("BasePart")
                                local prompt = targetModel:FindFirstChildWhichIsA("ProximityPrompt", true)
                                
                                if part and prompt and valor > maiorValor then
                                    maiorValor = valor
                                    prompt.RequiresLineOfSight = false
                                    prompt.MaxActivationDistance = 50
                                    melhor = {model = targetModel, part = part, prompt = prompt, mpsText = txtMPS, titleText = txtTitle, rawValue = valor}
                                end
                            end
                        end
                    end
                end
                Core.BestPet = melhor
                if melhor then ESP.Update(melhor.model, melhor.part, melhor.titleText, melhor.mpsText)
                else ESP.Update(nil, nil, "", "") end
            end)
        end
    end)
end

function Core.TeleportAndClaim()
    if Core.IsTeleporting or not Core.BestPet then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if hrp and Core.BestPet.prompt and Core.BestPet.part then
        Core.IsTeleporting = true
        local originalCFrame = hrp.CFrame -- Salva a posição original de onde você deu o TP
        local prompt = Core.BestPet.prompt
        
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = Core.BestPet.part.CFrame + Vector3.new(0, 3, 0) -- TP para o melhor pet
        task.wait(0.1)
        
        -- Ativa o prompt
        prompt.HoldDuration = 0
        for _ = 1, 3 do
            if fireproximityprompt then fireproximityprompt(prompt, 1) else prompt:InputHoldBegin() prompt:InputHoldEnd() end
            task.wait(0.05)
        end
        
        -- Espera exatamente 0.7 segundos após ativar o prompt
        task.wait(0.7) 
        
        -- Volta para a posição original de onde você deu o TP
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = originalCFrame
        Core.IsTeleporting = false
    end
end

Core.Scan()

