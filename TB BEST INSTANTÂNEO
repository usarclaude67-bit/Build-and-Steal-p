-- ========================================================================
-- RENDER LOOP: SISTEMA DE CORES PERSISTENTE (VERMELHO < 50m | AZUL > 50m)
-- ========================================================================
RunService.RenderStepped:Connect(function()
    pcall(function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local function GetColor(targetPos)
            local dist = (hrp.Position - targetPos).Magnitude
            return dist <= 50 and COLOR_NEAR or COLOR_FAR, dist
        end

        -- 1. Atualizar ESP do Pet/Modelo Focado
        if ESP.Billboard.Adornee then
            local color = GetColor(ESP.Billboard.Adornee.Position)
            ESP.Highlight.FillColor = color
            ESP.Highlight.OutlineColor = color
            if ESP.Stroke then ESP.Stroke.Color = color end
            ESP.TextLabel.TextColor3 = color
        end

        -- 2. Atualizar ESP dos Jogadores (Pessoas)
        for otherPlayer, espData in pairs(PlayerESPs) do
            local char2 = otherPlayer.Character
            local hrp2 = char2 and char2:FindFirstChild("HumanoidRootPart")
            if hrp2 then
                local color, dist = GetColor(hrp2.Position)
                espData.Highlight.Adornee = char2
                espData.Billboard.Adornee = hrp2
                espData.Highlight.FillColor = color
                espData.Highlight.OutlineColor = color
                espData.Text.TextColor3 = color
                espData.Text.Text = string.format("%s\n[%.1fm]", otherPlayer.Name, dist)
                
                espData.Highlight.Enabled = true
                espData.Billboard.Enabled = true
            else
                espData.Highlight.Enabled = false
                espData.Billboard.Enabled = false
            end
        end

        -- 3. Atualizar Beam (Bion)
        local beam = Workspace:FindFirstChild("MyBaseLaunchPadBeam")
        if beam and beam.Attachment1 and beam.Attachment1.Parent then
            local padPart = beam.Attachment1.Parent
            if padPart:IsA("BasePart") then
                local color = GetColor(padPart.Position)
                beam.Color = ColorSequence.new(color)
            end
        end

        -- 4. Atualizar Auras (Highlights) dos Launchpads
        local plots = Workspace:FindFirstChild("Plots")
        if plots then
            for _, plot in ipairs(plots:GetChildren()) do
                local builds = plot:FindFirstChild("Builds")
                if builds then
                    local pad = builds:FindFirstChild("LaunchPad")
                    if pad and pad.PrimaryPart then
                        local hl = pad:FindFirstChild("PadAura")
                        if hl then
                            local color = GetColor(pad.PrimaryPart.Position)
                            hl.FillColor = color
                            hl.OutlineColor = color
                        end
                    end
                end
            end
        end
    end)
end)

