local function enforceWalkSpeed(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        hum.WalkSpeed = 41
        hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if hum.WalkSpeed ~= 41 then hum.WalkSpeed = 41 end
        end)
    end
end

