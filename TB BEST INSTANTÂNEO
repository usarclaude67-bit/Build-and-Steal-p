-- ========================================================================
-- LÓGICA DO PLOT E LAUNCHPAD (MY BASE) COM ATTRIBUTE
-- ========================================================================
local function GetPlayerLaunchPad()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end
    
    for _, plot in ipairs(plots:GetChildren()) do
        local ownerId = plot:GetAttribute("OwnerUserId")
        if ownerId and tostring(ownerId) == tostring(player.UserId) then
            local builds = plot:FindFirstChild("Builds")
            if builds then
                local pad = builds:FindFirstChild("LaunchPad")
                if pad and (pad:IsA("BasePart") or pad:IsA("Model")) then
                    return pad:IsA("Model") and (pad.PrimaryPart or pad:FindFirstChildWhichIsA("BasePart")) or pad
                end
            end
        end
    end
    return nil
end

